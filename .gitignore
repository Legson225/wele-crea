# ─── WELE CREA — .gitignore ──────────────────────────────────────────────────

# Variables d'environnement — AUCUN FICHIER .env ne va sur GitHub
.env
.env.local
.env.example
.env.example.local
.env.production
.env.production.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.*.local
.env.*

# Next.js
.next/
out/
build/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editeurs
.vscode/
.idea/
*.swp
*.swo

# Logs
logs/
*.log

# Donnees sensibles
*.pem
*.key
*.p12
*.pfx
*.cert

# Scripts de deploiement locaux (contiennent des tokens)
push-github.bat
push-github.ps1
